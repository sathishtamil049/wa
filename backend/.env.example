# ── Copy this file to .env  (exactly ".env" — NOT ".env.txt"!) ──────────────
# XAMPP / MariaDB defaults are shown below.
# Rules: no quotes, no spaces around "=", one KEY=value per line.

# 127.0.0.1 is safer than "localhost" (avoids socket resolution issues)
DB_HOST=127.0.0.1

# XAMPP default port. If XAMPP shows MySQL on another port, match it here.
DB_PORT=3306

# XAMPP default user
DB_USER=root

# ⚠ XAMPP ships with an EMPTY root password.
# Leave the line blank like this:  DB_PASSWORD=
# Writing DB_PASSWORD=root is the #1 cause of "Access denied".
DB_PASSWORD=

# Must already exist — create it by importing database/schema.sql in phpMyAdmin
DB_NAME=milkpro

# Port this Express API listens on (5173 is Vite's dev server)
PORT=3001
CORS_ORIGIN=http://localhost:5173
